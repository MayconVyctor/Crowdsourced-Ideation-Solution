<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-add-created-at-updated-at-to-users-table" author="maycon.vyctor">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="users" columnName="created_at"/>
            </not>
        </preConditions>
        <comment>Add created_at and updated_at columns to existing users table with automatic MySQL timestamps</comment>
        <addColumn tableName="users">
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="users" columnName="created_at"/>
            <dropColumn tableName="users" columnName="updated_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
